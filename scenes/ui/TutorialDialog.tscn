[node name="RulesText" type="Label" parent="RootControl/Dimmer/Center/ModalPanel/VBox/Scroll/ContentVBox/RulesSection/VBox"]
modulate = Color(0.85, 0.9, 0.95, 0.9)
layout_mode = 2
autowrap_mode = 2
text = "• ТОПЛИВО: Расходуется при движении и работе печи. Если топливо кончится, дом встанет, а печь погаснет.
• ОПОРЫ И РЕМОНТ: Ноги изнашиваются от ходьбы. При износе скорость падает. Чините их в верстаке [U] за металлолом (+20% за штуку).
• ТЕПЛО И ЗДОРОВЬЕ: Температура в доме остывает. Топите печь [F], чтобы согреться. Ниже 0°C здоровье быстро тает!
• СБОР РЕСУРСОВ: Заметив ящик или брошенный тягач, остановите дом, выйдите [E] и обыщите объект. Страховочный трос не даст потеряться (предел 50 м).
• МЕТЕЛЬ: При приближении шторма звучит сирена (за 20 сек). Возвращайтесь в дом и топите печь — на улице буря смертельна!"

